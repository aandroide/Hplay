{
    "name": "[COLOR blue]s4me[/COLOR]_[COLOR orange]AnimeUnity[/COLOR]",
    "plugin": "plugin.video.s4me",
    "priority": 99,
    "is_resolvable": "false",
    "play_movie": [
        "plugin://plugin.video.s4me/?%3D",
        {
            "keyboard": "{title}"
        },
        {
            "label": "(?i)^.*{title}.*$"
        }
    ],
    "play_episode": [
        "plugin://plugin.video.s4me/?%3D",
        {
            "keyboard": "{showname}"
        },
        {
            "label": "(?i)^(?!.*\\b(movie|film|ova|ona|special)\\b).*{showname}.*$"
        },
        {
            "label": "(?i)^.*\\b{episode}\\. (Episodio|Parte) {episode}\\b.*$"
        }
    ],
    "fallback": {
        "play_movie": "S4Me_ricerca.json play_movie",
        "play_episode": "S4Me_ricerca.json play_episode"
    }
}
