{
    "name"              : "[COLOR aqua]MK[/COLOR]_[COLOR red]Film/Serie TMDB[/COLOR]",
    "plugin"            : "plugin.video.mandrakodi",
    "priority"          : 100,
    "is_resolvable"     : "false",
    "assert": {
        "play_movie"    : ["tmdb"]
    },
    "play_movie": [
        "plugin://plugin.video.mandrakodi/?action=myresolve&url=tmdb&parIn={tmdb}",
        {"return": "true", "title": "(?i)^.*PLAY.*$"},
        {"dialog": "true", "strict": "true", "label": "{title}"}
    ],
    "play_episode": [
        "plugin://plugin.video.mandrakodi/?action=myresolve&url=tmdbs&parIn={tmdb}_{season}_{episode}",
        {"return": "true", "title": "(?i)^.*PLAY.*$"},
		{"dialog": "true", "strict": "true", "label": "{showname}", "title": "(?i)^.*{showname}.*$"}
    ]
}